{
  "name": "infra",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.4.2",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "staging:start": "scripts/staging-start.sh",
    "staging:stop": "STAGING_RUNNING=false pulumi up -s staging"
  },
  "dependencies": {
    "@pulumi/aws": "^7.55.0",
    "@pulumi/cloudflare": "^6.24.0",
    "@pulumi/pulumi": "^3.277.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
