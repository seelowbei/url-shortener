# Secrets for `kamal ... -d staging`. Only references live here, never values.
# Every value is read from an environment variable of the same name:
# - CI: the GitHub `staging` environment secrets.
# - Laptop: export them in your shell first, e.g. from your password manager (see the PR or
#   docs/spec/infrastructure.md#kamal).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
